{
  "name": "omniflow-qa",
  "version": "0.3.0-beta.2",
  "description": "Enterprise-grade unified Web and Mobile QA automation suite featuring live screen recording and auto-healing.",
  "main": "electron-main.js",
  "scripts": {
    "build": "tsc && webpack --config config/webpack.config.js",
    "package": "npm run build && electron-builder",
    "dev": "tsc --watch",
    "test": "jest",
    "test:coverage": "jest --coverage --runInBand",
    "test:e2e:electron": "npm run build && node tests/e2e/electron-smoke.js",
    "test:e2e:mobile-physical": "npm run build && node tests/e2e/mobile-recording-physical.js",
    "lint": "eslint src/**/*.ts",
    "check": "npm run lint && npm test -- --runInBand && npm run build",
    "start": "npm run build && electron .",
    "start:cli": "node dist/index.js",
    "run:cli": "npm run build && node dist/cli.js",
    "demo": "npx tsc example.ts --module commonjs --esModuleInterop --target es2020 && node example.js"
  },
  "keywords": [
    "chromium",
    "automation",
    "testing",
    "selenium",
    "playwright",
    "auto-healing",
    "scraping",
    "qa",
    "element-discovery",
    "page-object-model",
    "ohscrapper"
  ],
  "author": "Infinity Lines of Code Pvt Ltd",
  "license": "MIT",
  "productName": "OmniFlow QA",
  "build": {
    "appId": "com.infinitylinesofcode.omniflowqa",
    "productName": "OmniFlow QA",
    "icon": "assets/omniflow-qa-icon.png",
    "copyright": "Copyright © 2026 Infinity Lines of Code Pvt Ltd",
    "artifactName": "OmniFlow-QA-Setup.${ext}",
    "linux": {
      "artifactName": "OmniFlow-QA.AppImage"
    },
    "win": {
      "icon": "assets/omniflow-qa-icon.png",
      "executableName": "omniflow-qa",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OmniFlow QA",
      "deleteAppDataOnUninstall": false
    },
    "directories": {
      "output": "release"
    }
  },
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "chrome-remote-interface": "^0.33.0",
    "electron-devtools-installer": "^4.0.0",
    "playwright-core": "^1.40.0",
    "puppeteer-core": "^25.4.0"
  },
  "devDependencies": {
    "electron": "^40.4.1",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.0.0",
    "typescript": "^5.0.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Infinity-Lines-of-Code/omniflow-qa.git"
  }
}
