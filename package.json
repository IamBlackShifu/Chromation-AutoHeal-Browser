{
  "name": "chromation-autoheal-browser",
  "version": "0.3.0-beta.1",
  "description": "Chromium-based automation browser with auto-healing capabilities and OhScrapper element discovery",
  "main": "electron-main.js",
  "scripts": {
    "build": "tsc && webpack --config config/webpack.config.js",
    "dev": "tsc --watch",
    "test": "jest",
    "test:coverage": "jest --coverage --runInBand",
    "lint": "eslint src/**/*.ts",
    "check": "npm run lint && npm test -- --runInBand && npm run build",
    "start": "npm run build && electron .",
    "start:cli": "node dist/index.js",
    "run:cli": "npm run build && node dist/cli.js",
    "demo": "npx tsc example.ts --module commonjs --esModuleInterop --target es2020 && node example.js"
  },
  "keywords": [
    "chromium",
    "automation",
    "testing",
    "selenium",
    "playwright",
    "auto-healing",
    "scraping",
    "qa",
    "element-discovery",
    "page-object-model",
    "ohscrapper"
  ],
  "author": "IamBlackShifu",
  "license": "MIT",
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "chrome-remote-interface": "^0.33.0",
    "electron": "^40.4.1",
    "electron-devtools-installer": "^4.0.0",
    "playwright-core": "^1.40.0",
    "puppeteer-core": "^25.4.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.0.0",
    "typescript": "^5.0.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/IamBlackShifu/Chromation-AutoHeal-Browser.git"
  }
}
